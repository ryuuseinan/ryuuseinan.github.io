---
import GitHub from "./icons/GitHub.astro"
import ExternalLink from "./icons/ExternalLink.astro"
import LinkButton from "./LinkButton.astro"
import projectsData from "@/data/projects.json"

const TAGS: Record<string, { name: string; class: string }> = {
  NODE: { name: "Node.js", class: "bg-[#1c3b22] text-[#7ee2a8]" },
  FLASK: { name: "Flask", class: "bg-[#2b2b2b] text-white" },
  PYTHON: { name: "Python", class: "bg-[#25406b] text-white" },
  REACT: { name: "React", class: "bg-[#0b3b4a] text-[#8fd8ea]" },
  OSU: { name: "osu! API", class: "bg-[#3a2233] text-[#f0a0c0]" },
  TELEGRAM: { name: "Telegram Bot", class: "bg-[#1c3b5a] text-[#8fc7ea]" },
  MIKROTIK: { name: "Mikrotik", class: "bg-[#3a2a1c] text-[#e0b585]" },
  DISCORD: { name: "Discord Bot", class: "bg-[#2c2f6b] text-[#a9b2ff]" },
  TWITCH: { name: "Twitch", class: "bg-[#3a2540] text-[#c9a0ff]" },
  DOTNET: { name: ".NET", class: "bg-[#2b2b6b] text-[#a9b6ff]" },
  SQLSERVER: { name: "SQL Server", class: "bg-[#5a2a2a] text-[#f0a8a8]" },
  HTML: { name: "HTML", class: "bg-[#5a2f1c] text-[#f0b48a]" },
  CSS: { name: "CSS", class: "bg-[#1c3a5a] text-[#8fbfea]" },
}

const PROJECTS = projectsData.map((project) => ({
  ...project,
  tags: project.tags.map((key) => TAGS[key]),
}))
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ images = [], title, description, tags, link, github }) => (
      <article
        class={`flex flex-col space-x-0 space-y-6 group md:flex-row md:space-x-10 md:space-y-0 ${images.length ? "" : "md:items-center"}`}
      >
        {images.length > 0 && (
          <div class="w-full md:w-1/2">
            <div data-gallery class="flex flex-col">
              <div class="relative flex items-center justify-center overflow-hidden rounded-xl border border-gray-200/70 dark:border-white/10 bg-gray-100 dark:bg-gray-900/60 shadow-xl aspect-video">
                <img
                  class="gallery-main object-contain w-full h-full"
                  alt={title}
                  loading="lazy"
                  src={images[0]}
                />
              </div>
              {images.length > 1 && (
                <div class="grid grid-cols-4 gap-2 mt-2">
                  {images.map((src, i) => (
                    <button
                      type="button"
                      class={`gallery-thumb overflow-hidden rounded-lg border transition ${i === 0 ? "border-yellow-400/70" : "border-transparent hover:border-yellow-400/40"}`}
                      data-src={src}
                      aria-label={`Ver captura ${i + 1}`}
                    >
                      <img
                        class="object-cover w-full h-14"
                        alt=""
                        loading="lazy"
                        src={src}
                      />
                    </button>
                  ))}
                </div>
              )}
            </div>
          </div>
        )}

        <div
          class={`w-full flex flex-col justify-center ${images.length ? "md:w-1/2 md:max-w-lg" : "md:max-w-2xl"}`}
        >
          <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
            {title}
          </h3>
          <ul class="flex flex-row flex-wrap mt-3 gap-2">
            {tags.map((tag) => (
              <li>
                <span class={`rounded-full text-xs font-medium ${tag.class} py-1 px-3`}>
                  {tag.name}
                </span>
              </li>
            ))}
          </ul>

          <p class="mt-3 text-gray-700 dark:text-gray-400 text-pretty">{description}</p>
          <footer class="flex items-center mt-4 gap-x-4">
            {github && (
              <LinkButton href={github}>
                <GitHub class="size-5" />
                Code
              </LinkButton>
            )}
            {link && (
              <LinkButton href={link}>
                <ExternalLink class="size-4" />
                Preview
              </LinkButton>
            )}
          </footer>
        </div>
      </article>
    ))
  }
</div>

<script>
  function initGalleries() {
    document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((gallery) => {
      if (gallery.dataset.ready) return
      gallery.dataset.ready = "1"

      const main = gallery.querySelector(".gallery-main")
      const thumbs = gallery.querySelectorAll<HTMLElement>(".gallery-thumb")

      thumbs.forEach((thumb) => {
        thumb.addEventListener("click", () => {
          main?.setAttribute("src", thumb.dataset.src ?? "")
          thumbs.forEach((t) => {
            t.classList.remove("border-yellow-400/70")
            t.classList.add("border-transparent")
          })
          thumb.classList.remove("border-transparent")
          thumb.classList.add("border-yellow-400/70")
        })
      })
    })
  }

  initGalleries()
  document.addEventListener("astro:page-load", initGalleries)
</script>
